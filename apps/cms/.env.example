# ---------------------------------------------------------------------------
# Payload CMS - environment for the app server (EC2 #2)
# Copy to `.env` next to docker-compose.yml and fill in the values.
# ---------------------------------------------------------------------------

# MongoDB running on your database EC2. Use its PRIVATE IP (same VPC) so traffic
# never leaves AWS. URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F).
#   mongodb://<user>:<password>@<mongo-private-ip>:27017/<database>?authSource=admin
DATABASE_URL=mongodb://payload:CHANGE_ME@10.0.1.23:27017/payload?authSource=admin

# Long random string used to sign auth tokens. Generate with: openssl rand -hex 32
# Never change it after going live (all users would be logged out and API keys break).
PAYLOAD_SECRET=CHANGE_ME

# Public URL the admin panel is opened from, WITHOUT a trailing slash.
# Must exactly match the browser address bar, otherwise logins are rejected (CSRF check).
#   With a domain + HTTPS:   https://cms.example.com
#   Without a domain (HTTP): http://<ec2-public-ip>
SERVER_URL=http://CHANGE_ME

# Address Caddy serves. Use the bare domain (e.g. cms.example.com) to get an automatic
# Let's Encrypt certificate, or `:80` to serve plain HTTP on the instance IP.
SITE_ADDRESS=:80

# Optional: extra comma-separated origins (e.g. your frontend) allowed to call the API with cookies
CORS_ORIGINS=

# Optional: MongoDB connection pool size
# DATABASE_MAX_POOL_SIZE=10
