# ---------------------------------------------------------------------------
# Payload CMS - environment for the app server (EC2 #2)
# Copy to `.env` next to docker-compose.yml and fill in the values.
# ---------------------------------------------------------------------------

# MongoDB running on your database EC2. Use its PRIVATE IP (same VPC) so traffic
# never leaves AWS. URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F).
#   mongodb://<user>:<password>@<mongo-private-ip>:27017/<database>?authSource=admin
DATABASE_URL=mongodb://payload:CHANGE_ME@10.0.1.23:27017/payload?authSource=admin

# Long random string used to sign auth tokens. Generate with: openssl rand -hex 32
# Never change it after going live (all users would be logged out and API keys break).
PAYLOAD_SECRET=CHANGE_ME

# Public URL the admin panel is opened from, WITHOUT a trailing slash.
# Must exactly match the browser address bar, otherwise logins are rejected (CSRF check).
#   With a domain + HTTPS:   https://cms.example.com
#   Without a domain (HTTP): http://<ec2-public-ip>
SERVER_URL=http://CHANGE_ME

# Address Caddy serves. Use the bare domain (e.g. cms.example.com) to get an automatic
# Let's Encrypt certificate, or `:80` to serve plain HTTP on the instance IP.
SITE_ADDRESS=:80

# Optional: extra comma-separated origins (e.g. your frontend) allowed to call the API with cookies
CORS_ORIGINS=

# Optional: MongoDB connection pool size
# DATABASE_MAX_POOL_SIZE=10

# ---------------------------------------------------------------------------
# Optional: store uploads in Amazon S3 instead of on this server (README: "Uploads in S3")
# Leave S3_BUCKET empty to keep files on the server's disk (Docker volume "media").
# ---------------------------------------------------------------------------
S3_BUCKET=
# Region of the bucket, e.g. ap-southeast-1
S3_REGION=
# Folder inside the bucket
S3_PREFIX=media
# Folder of the personal website's photos. Default: <S3_PREFIX>/photos, which the bucket policy and
# IAM role for S3_PREFIX already cover
# S3_PHOTOS_PREFIX=media/photos
# Base URL frontends load files from. Default: https://<bucket>.s3.<region>.amazonaws.com
# With CloudFront in front of the bucket, use its domain, e.g. https://cdn.example.com
S3_PUBLIC_URL=
# Leave both empty when the EC2 instance has an IAM role (recommended); otherwise IAM user keys
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for older buckets that use ACLs instead of a bucket policy to make files public
# S3_ACL=public-read
# Only for S3-compatible services (MinIO, Cloudflare R2, ...)
# S3_ENDPOINT=https://...
# S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Optional: refresh the personal website as soon as its content changes (README: "Personal website")
# Without these, the website still picks up changes on its own within about a minute.
# ---------------------------------------------------------------------------
# Public URL of the website, without a trailing slash, e.g. https://www.example.com
WEBSITE_URL=
# The same value as REVALIDATE_SECRET on the website. Generate with: openssl rand -hex 32
WEBSITE_REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Optional: write the title, alt text, description and tags of photos with AI (README: "Photos")
# Without OPENAI_API_KEY, photos are uploaded without them and you write them yourself.
# ---------------------------------------------------------------------------
# API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# A model that understands images. Default: gpt-5-mini
# OPENAI_MODEL=gpt-5-mini
# Only for an OpenAI-compatible API other than OpenAI's, e.g. Azure OpenAI or a proxy
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Optional: refresh the Vigor website as soon as its content changes (README: "Vigor website")
# Without these, the website still picks up changes on its own within about a minute.
# ---------------------------------------------------------------------------
# Public URL of the Vigor website, without a trailing slash, e.g. https://www.example.com
VIGOR_WEBSITE_URL=
# The same value as REVALIDATE_SECRET on the Vigor website. Generate with: openssl rand -hex 32
VIGOR_WEBSITE_REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Optional: let the VgemsAI app's backend (awoz-api) read upcoming events (README: "Events in the VgemsAI app")
# Without APP_API_KEY, GET /api/app/events is turned off (404).
# ---------------------------------------------------------------------------
# The same value as PAYLOAD_API_KEY on awoz-api. Generate with: openssl rand -hex 32
APP_API_KEY=

# ---------------------------------------------------------------------------
# Optional: put events on the map with the Apple Maps Server API (README: "Event locations")
# Without these, events are saved without coordinates and the VgemsAI app looks them up itself.
# ---------------------------------------------------------------------------
# 10-character Team ID (Apple Developer account > Membership)
APPLE_MAPS_TEAM_ID=
# 10-character Key ID of a key with MapKit JS enabled (Certificates, Identifiers & Profiles > Keys)
APPLE_MAPS_KEY_ID=
# Contents of the key's .p8 file on one line: the lines between BEGIN and END joined together,
# or the whole file with \n for each line break
APPLE_MAPS_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Optional: send emails such as "forgot password" through SendGrid (README: "Email (SendGrid)")
# Without SENDGRID_API_KEY, emails are only written to the server log.
# ---------------------------------------------------------------------------
# API key with the "Mail Send" permission (Settings > API Keys in SendGrid)
SENDGRID_API_KEY=
# A sender verified in SendGrid (Single Sender Verification or an authenticated domain)
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Payload CMS
# Only for SendGrid EU data residency
# SENDGRID_API_URL=https://api.eu.sendgrid.com
