{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@payload-config": ["./app-tanstack/payload-config.d.ts"],
      "@payloadcms/tanstack-start/*": ["../packages/tanstack-start/dist/exports/*.d.ts"],
      "@payloadcms/translations": ["../packages/translations/dist/index.d.ts"],
      "@payloadcms/ui": ["../packages/ui/dist/exports/client/index.d.ts"],
      "@payloadcms/ui/*": ["../packages/ui/dist/*"],
      "payload": ["../packages/payload/dist/index.d.ts"],
      "payload/*": ["../packages/payload/dist/exports/*.d.ts"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  }
}
