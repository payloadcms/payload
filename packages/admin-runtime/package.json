{
  "name": "@payloadcms/admin-runtime",
  "version": "4.0.0-beta.2",
  "description": "The Payload admin panel, prebuilt. Mounted with a single route handler, so the host framework compiles none of it.",
  "homepage": "https://payloadcms.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/payloadcms/payload.git",
    "directory": "packages/admin-runtime"
  },
  "license": "MIT",
  "author": "Payload <dev@payloadcms.com> (https://payloadcms.com)",
  "maintainers": [
    {
      "name": "Payload",
      "email": "info@payloadcms.com",
      "url": "https://payloadcms.com"
    }
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./runtime": {
      "import": "./dist/runtime/rsc/index.js",
      "default": "./dist/runtime/rsc/index.js"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm build:types && pnpm build:swc && pnpm build:runtime",
    "build:runtime": "vite build --configLoader runner",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "clean": "rimraf -g {dist,*.tsbuildinfo}",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@payloadcms/richtext-lexical": "workspace:*",
    "@payloadcms/tanstack-start": "workspace:*",
    "@payloadcms/translations": "workspace:*",
    "@payloadcms/ui": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitejs/plugin-rsc": "^0.5.21",
    "payload": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rsc-html-stream": "0.0.7",
    "vite": ">=8.0.0"
  },
  "peerDependencies": {
    "payload": "workspace:*"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./runtime": {
        "import": "./dist/runtime/rsc/index.js",
        "default": "./dist/runtime/rsc/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  }
}
