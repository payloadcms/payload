{
  "name": "@payloadcms/plugin-mcp",
  "version": "4.0.0-beta.4",
  "description": "MCP (Model Context Protocol) capabilities with Payload",
  "keywords": [
    "mcp",
    "model context protocol",
    "plugin"
  ],
  "license": "MIT",
  "author": "Payload <dev@payloadcms.com> (https://payloadcms.com)",
  "maintainers": [
    {
      "name": "Payload",
      "email": "info@payloadcms.com",
      "url": "https://payloadcms.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/payloadcms/payload.git",
    "directory": "packages/plugin-mcp"
  },
  "bin": {
    "payload-mcp": "./bin.js"
  },
  "files": [
    "src",
    "dist",
    "bin.js"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "import": "./src/exports/client.ts",
      "types": "./src/exports/client.ts",
      "default": "./src/exports/client.ts"
    },
    "./stdio": {
      "import": "./src/stdio.ts",
      "types": "./src/stdio.ts",
      "default": "./src/stdio.ts"
    },
    "./internal": {
      "import": "./src/exports/internal.ts",
      "types": "./src/exports/internal.ts",
      "default": "./src/exports/internal.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "import": "./dist/exports/client.js",
        "types": "./dist/exports/client.d.ts",
        "default": "./dist/exports/client.js"
      },
      "./stdio": {
        "import": "./dist/stdio.js",
        "types": "./dist/stdio.d.ts",
        "default": "./dist/stdio.js"
      },
      "./internal": {
        "import": "./dist/exports/internal.js",
        "types": "./dist/exports/internal.d.ts",
        "default": "./dist/exports/internal.js"
      }
    }
  },
  "scripts": {
    "build": "pnpm copyfiles && pnpm build:types && pnpm build:swc",
    "build:debug": "pnpm build",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "copyfiles -u 1 -e \"**/*.spec.*\" \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,json}\" dist/",
    "pack:plugin": "pnpm build && pnpm pack"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "payload": "workspace:*"
  },
  "peerDependencies": {
    "payload": "workspace:*"
  },
  "//deps_notes": {
    "tsx": "Required by the `bin.js` stdio mcp. Keep the version pinned to whatever `payload` ships to avoid duplicate installs."
  },
  "homepage:": "https://payloadcms.com"
}
