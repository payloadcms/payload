{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "clean": {
      "cache": false,
      "dependsOn": ["^clean"]
    },
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["./dist/**"]
    },
    "build:debug": {
      "cache": true,
      "dependsOn": ["^build:debug"],
      "outputs": ["./dist/**"]
    },
    "build:bundle-for-analysis": {
      "cache": true,
      "dependsOn": ["^build:bundle-for-analysis"],
      "outputs": ["./esbuild/**"]
    },
    "dev": {
      "cache": false
    },
    "create-payload-app#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tools/upgrade/**",
        "$TURBO_ROOT$/tools/releaser/src/lib/publishList.ts",
        "$TURBO_ROOT$/packages/*/package.json"
      ],
      "outputs": ["dist/**", "src/upgrade-shared/**"]
    },
    "create-payload-app#build:debug": {
      "dependsOn": ["^build:debug"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tools/upgrade/**",
        "$TURBO_ROOT$/tools/releaser/src/lib/publishList.ts",
        "$TURBO_ROOT$/packages/*/package.json"
      ],
      "outputs": ["dist/**", "src/upgrade-shared/**"]
    },
    "@payloadcms/codemod#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tools/upgrade/**",
        "$TURBO_ROOT$/tools/releaser/src/lib/publishList.ts",
        "$TURBO_ROOT$/packages/*/package.json"
      ],
      "outputs": ["dist/**", "src/upgrade-shared/**"]
    }
  }
}
