{
  "name": "with-cloudflare-d1-tanstack",
  "version": "1.0.0",
  "description": "Payload CMS + TanStack Start on Cloudflare Workers with D1 and R2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm --max-old-space-size=8000\" payload build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "deploy": "pnpm run migrate:remote && pnpm run build && wrangler deploy",
    "dev": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" vite dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "pnpm run cf-typegen && cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_SECRET=migration-only payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_SECRET=migration-only payload migrate:create",
    "migrate:remote": "cross-env NODE_ENV=production PAYLOAD_SECRET=migration-only PAYLOAD_MIGRATE_REMOTE=true payload migrate",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "preview": "pnpm run build && cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" CLOUDFLARE_RUNTIME=true vite preview",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@payloadcms/db-d1-sqlite": "workspace:*",
    "@payloadcms/graphql": "workspace:*",
    "@payloadcms/richtext-lexical": "workspace:*",
    "@payloadcms/storage-r2": "workspace:*",
    "@payloadcms/tanstack-start": "workspace:*",
    "@payloadcms/ui": "workspace:*",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.1",
    "cross-env": "10.1.0",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "payload": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.3",
    "@vitejs/plugin-rsc": "^0.5.21",
    "eslint": "^9.16.0",
    "esbuild": "0.28.2",
    "jsdom": "28.0.0",
    "oxfmt": "^0.73.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.1",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  },
  "cloudflare": {
    "bindings": {
      "PAYLOAD_SECRET": {
        "description": "Generate a random string using `openssl rand -hex 32`"
      }
    }
  }
}
